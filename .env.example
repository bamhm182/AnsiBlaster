# Copy to .env and adjust as needed -- docker-compose.yml reads these automatically.

# Host port to publish the web UI on.
HOST_PORT=8000

# Container user remapping (see docker-entrypoint.sh). Set these to match the host user that
# owns HOST_ROLES_DIR/HOST_PLAYBOOKS_DIR below, e.g. `id -u`/`id -g` for your own user.
PUID=1000
PGID=1000

# Host paths bind-mounted into the container at /opt/ansible/roles and /opt/ansible/playbooks.
# Default to the bundled example/ LAMP stack -- point these at your own roles/playbooks once
# you have real ones to run (see example/README.md).
HOST_ROLES_DIR=./example/roles
HOST_PLAYBOOKS_DIR=./example/playbooks
